---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import Meta from '../components/Meta.astro';
import Icon from '../components/Icon.astro';

export async function getStaticPaths() {
  const berichten = await getCollection('berichten', (b) => !b.data.verborgen);
  // De oude WordPress-adressen eindigden op .htm; die houden we gelijk
  return berichten.map((bericht) => ({ params: { bericht: `${bericht.id}.htm` }, props: { bericht } }));
}

const { bericht } = Astro.props;
const { Content } = await render(bericht);
const d = bericht.data;
const terug = d.categorie === 'agenda'
  ? { href: '/activiteiten', tekst: 'Activiteiten' }
  : { href: '/subsidies', tekst: 'Subsidies' };
const beschrijving = d.samenvatting.split(/\n\s*\n/)[0];
---
<Basis titel={d.titel} beschrijving={beschrijving}>
  <article class="bericht">
    <div class="wrap smal">
      <a class="terug" href={terug.href}><Icon naam="pijlLinks" /> {terug.tekst}</a>
      <h1>{d.titel}</h1>
      <Meta bericht={bericht} />
      <div class="opmaak">
        <Content />
      </div>
      {d.downloads && (
        <ul class="downloads">
          {d.downloads.map((dl) => (
            <li><a class="knop" href={dl.bestand} download><Icon naam="download" /> {dl.tekst}</a></li>
          ))}
        </ul>
      )}
      {d.galerij && (
        <div class="galerij">
          {d.galerij.map((foto) => (
            <a href={foto.src} target="_blank" rel="noopener">
              <Image src={foto} alt="" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
            </a>
          ))}
        </div>
      )}
    </div>
  </article>
</Basis>
